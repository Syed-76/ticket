DISCORD_TOKEN=your_bot_token
CLIENT_ID=your_application_id
GUILD_ID=your_test_server_id
PREFIX=!
# Optional defaults; /ticket-setup can override these per server.
SUPPORT_ROLE_ID=
TICKET_CATEGORY_ID=
TRANSCRIPT_CHANNEL_ID=
# Dashboard and OAuth2
PORT=3000
PUBLIC_URL=https://your-service.onrender.com
DISCORD_CLIENT_ID=your_discord_application_id
DISCORD_CLIENT_SECRET=your_discord_oauth2_client_secret
SESSION_SECRET=generate-a-long-random-secret
# MongoDB Atlas free-tier connection string
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/ticket_command?retryWrites=true&w=majority
# Optional per-department category and staff-role defaults.
TICKET_SUPPORT_CATEGORY_ID=
TICKET_SUPPORT_ROLE_ID=
TICKET_REPORT_CATEGORY_ID=
TICKET_REPORT_ROLE_ID=
TICKET_PARTNERSHIP_CATEGORY_ID=
TICKET_PARTNERSHIP_ROLE_ID=
TICKET_APPLICATION_CATEGORY_ID=
TICKET_APPLICATION_ROLE_ID=
TICKET_BILLING_CATEGORY_ID=
TICKET_BILLING_ROLE_ID=
