SESSION_SECRET=generate-a-long-random-secret
# MongoDB Atlas free-tier connection string
MONGODB_URI=mongodb+srv://syedrevenge76_db_user:<db_password>@cluster0.qshoflo.mongodb.net/?appName=Cluster0
